# Hive seed config. Copy to hive.yaml on selfie (cp -n hive.yaml.seed
# hive.yaml) — the copy is bind-mounted at /etc/hive/hive.yaml and the
# running process REWRITES it (env vars expanded, secrets inlined), which is
# why hive.yaml itself is gitignored, matching upstream's layout where
# hive.yaml is always an untracked local file. After first boot the
# dashboard's overlay on the data volume (/data/hive.yaml.runtime) wins over
# the file anyway; change runtime settings through the dashboard.
project:
  org: frostyard
  repos: [snosi, testsuite, lab, updex, chairlift, pilothouse]
  primary_repo: snosi

agents:
  guide:
    enabled: true
    backend: copilot
    model: claude-sonnet-4-6
  scanner:
    enabled: true
    backend: copilot
    model: claude-sonnet-4-6

governor:
  eval_interval_s: 300
  modes:
    idle: { threshold: 0,  guide: 4h, scanner: 4h }
    busy: { threshold: 10, guide: 2h, scanner: 2h }

github:
  app_id: 4518769
  installation_id: 151997502
  app_slug: frostyard-hive
  key_file: /secrets/gh-app-key.pem
  forge: github.com
  # Public device-flow OAuth client for dashboard sign-in (no secret).
  oauth_client_id: Ov23ligE2p0gjXg6xAUf

dashboard:
  # 3002 = the Go API (entrypoint HIVE_API_PORT default, what the container
  # healthcheck probes). The node proxy takes 3001 (HIVE_PROXY_PORT), which
  # the nginx gateway fronts on the host. Do NOT set 3001 here — the API
  # then collides with the proxy and the healthcheck port goes dead.
  # (Upstream's hive.yaml.example says 3001; that contradicts its own
  # entrypoint/compose healthcheck defaults.)
  port: 3002
  auth_token: ${HIVE_DASHBOARD_TOKEN}
  # First entry is the owner (read-write); later entries default to viewer.
  authorized_users: [bketelsen:owner]
  # No hub auth proxy in front of this spoke — direct device-flow login.
  hub_proxied: false

hub:
  enabled: false

acmm_level: 2
