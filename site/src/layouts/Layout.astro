---
import '../styles/global.css';

const {
  title = 'frostyard lab',
  description = 'QA pipeline status for snosi bootc images',
  eyebrow = 'continuous QA · snosi bootc images',
  heading = 'Pipeline status',
  stamp = null,
} = Astro.props;

// BASE_URL carries a trailing slash from Astro's `base`, so join without doubling.
const asset = (p) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${p}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const page = (p = '') => `${base}/${p}`;
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const pipelineActive = currentPath === base;
const hiveActive = currentPath === `${base}/hive`;
const hiveConfigured = Boolean(import.meta.env.PUBLIC_HIVE_API_URL);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
  </head>
  <body>
    <div class="shell">
      <nav class="nav">
        <a class="brand" href={import.meta.env.BASE_URL}>
          <span class="flake">❄</span>
          <span><strong>frostyard</strong><small>lab</small></span>
        </a>
        <div class="navlinks">
          <a class:list={['navlink', { active: pipelineActive }]} href={page()}>Pipeline</a>
          {hiveConfigured && (
            <a class:list={['navlink', { active: hiveActive }]} href={page('hive/')}>Hive</a>
          )}
          <a class="source" href="https://github.com/frostyard/lab">Source ↗</a>
        </div>
      </nav>

      <main class="main">
        <div class="topbar">
          <div>
            <div class="eyebrow"><i></i>{eyebrow}</div>
            <h1>{heading}</h1>
          </div>
          {stamp && (
            <div class="topbar-actions">
              <div class="live"><span></span>Data · {stamp}</div>
            </div>
          )}
        </div>
        <slot />
      </main>

      <footer class="foot">
        Generated from the <span class="mono">selfie</span> cluster by
        <a href="https://github.com/frostyard/lab">frostyard/lab</a>.
        Cluster state is reconciled from git by Argo CD; this page is a read-only view.
      </footer>
    </div>
  </body>
</html>

<style>
  .shell {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-pad) 3rem;
  }

  /* Nav — brand wordmark left, the one pill the system allows on the right. */
  .nav {
    align-items: center;
    border-bottom: 1px solid var(--line);
    display: flex;
    gap: 12px;
    justify-content: space-between;
    min-height: 64px;
  }
  .brand {
    align-items: center;
    color: var(--text-body);
    display: flex;
    gap: 9px;
    text-decoration: none;
    white-space: nowrap;
  }
  .brand .flake { color: var(--ice); font-size: 1.45rem; }
  .brand strong {
    display: block;
    font-size: var(--brand-size);
    font-weight: var(--brand-weight);
    letter-spacing: var(--brand-ls);
    line-height: 1.15;
  }
  .brand small {
    color: var(--text-eyebrow);
    display: block;
    font: 400 10px var(--font-mono);
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .brand:hover strong { color: var(--ice); }
  .navlinks { align-items: center; display: flex; gap: 7px; }
  .navlink {
    color: var(--text-muted);
    font-size: var(--text-caption-size);
    font-weight: 600;
    padding: 6px 8px;
    text-decoration: none;
  }
  .navlink:hover, .navlink.active { color: var(--ice); }
  .navlink.active { border-bottom: 1px solid var(--sky); }
  .source {
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    color: var(--tag-text);
    font-size: var(--text-caption-size);
    font-weight: 600;
    padding: 6px 14px;
    text-decoration: none;
    white-space: nowrap;
  }
  .source:hover { border-color: #8fdffb66; color: var(--ice); }

  /* Topbar — eyebrow dash + kicker above the page heading. */
  .topbar {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: space-between;
    padding: 1.75rem 0 1.5rem;
  }
  .eyebrow {
    color: var(--text-eyebrow);
    font-size: var(--text-eyebrow-size);
    font-weight: var(--text-eyebrow-weight);
    letter-spacing: var(--text-eyebrow-ls);
    margin-bottom: 6px;
    text-transform: uppercase;
  }
  .eyebrow i {
    background: var(--sky);
    display: inline-block;
    height: 1px;
    margin-right: .6rem;
    vertical-align: middle;
    width: var(--eyebrow-dash-w);
  }
  h1 {
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -.055em;
    line-height: 1;
    margin: 0;
  }
  .topbar-actions { align-items: center; display: flex; gap: 10px; }
  .live {
    align-items: center;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    color: var(--text-mono-accent);
    display: flex;
    font: 700 9.5px var(--font-mono);
    gap: 7px;
    letter-spacing: .1em;
    padding: 6px 11px;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .live > * { flex-shrink: 0; }
  .live span:empty {
    animation: pulse 2s infinite;
    background: var(--sky);
    border-radius: 50%;
    height: 6px;
    width: 6px;
  }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(71, 184, 239, .4); }
    50% { box-shadow: 0 0 0 5px rgba(71, 184, 239, 0); }
  }
  @media (prefers-reduced-motion: reduce) { .live span:empty { animation: none; } }

  .foot {
    border-top: 1px solid var(--line);
    color: var(--text-footer);
    font-size: var(--text-caption-size);
    margin-top: 3.5rem;
    padding-top: 1.25rem;
  }
  .mono { color: var(--text-mono-accent); font-family: var(--font-mono); font-size: .9em; }

  @media (max-width: 640px) {
    .shell { padding: 0 var(--container-pad-mobile) 2.5rem; }
    .navlink { padding-inline: 4px; }
    .source { padding-inline: 9px; }
  }
</style>
