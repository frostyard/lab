---
import Layout from '../layouts/Layout.astro';
import data from '../data/runs.json';

const { generated, lanes = [], runs = [] } = data;

// Argo phases collapse to three states worth colouring. Anything still moving
// is "running" rather than a fourth colour nobody can interpret at a glance.
// The names match the design system's --state-ok/warn/danger tokens.
function state(phase) {
  if (phase === 'Succeeded') return 'ok';
  if (phase === 'Failed' || phase === 'Error') return 'danger';
  return 'warn';
}

// A lane that has never once succeeded is a different claim from a lane that
// went red. It is not evidence about the thing under test — it is evidence that
// nobody has shown the lane can pass. Two false bug reports against snosi came
// from reading a never-green lane's red as a finding, so the distinction earns
// its own state rather than living in a comment. See docs/roadmap.md.
function laneState(lane) {
  if (lane.everGreen === false && state(lane.latest.phase) === 'danger') return 'unproven';
  return state(lane.latest.phase);
}

function laneLabel(lane) {
  return laneState(lane) === 'unproven' ? 'unproven' : lane.latest.phase;
}

function duration(seconds) {
  if (seconds == null) return '—';
  if (seconds < 90) return `${seconds}s`;
  const m = Math.floor(seconds / 60);
  return m < 90 ? `${m}m` : `${Math.floor(m / 60)}h ${m % 60}m`;
}

function when(ts) {
  if (!ts) return '—';
  return ts.replace('T', ' ').replace('Z', ' UTC');
}

// The topbar pill is a mono kicker, so it drops seconds to stay one short line.
function stampOf(ts) {
  if (!ts) return null;
  return ts.replace('T', ' ').replace(/:\d\dZ$/, ' UTC');
}

const KIND_ORDER = ['container', 'install', 'vm', 'poll', 'maintenance', 'other'];
const KIND_LABEL = {
  container: 'Container suites',
  install: 'Installers',
  vm: 'VM boot',
  poll: 'Registry polling',
  maintenance: 'Maintenance',
  other: 'Other',
};

const grouped = KIND_ORDER
  .map((kind) => ({ kind, label: KIND_LABEL[kind], lanes: lanes.filter((l) => l.kind === kind) }))
  .filter((g) => g.lanes.length);

const recent = runs.slice(0, 40);
const empty = runs.length === 0;

const passing = lanes.filter((l) => laneState(l) === 'ok').length;
const failing = lanes.filter((l) => laneState(l) === 'danger').length;
const moving = lanes.filter((l) => laneState(l) === 'warn').length;
const unproven = lanes.filter((l) => laneState(l) === 'unproven').length;
const retained = lanes.reduce((n, l) => n + (l.runs || 0), 0);
---
<Layout stamp={stampOf(generated)}>
  <section class="hero">
    <div class="hero-kicker"><span></span>selfie cluster · argo workflows</div>
    <h2>Keep the base still. <em>Prove it every build.</em></h2>
    <p>
      Continuous QA for <a href="https://github.com/frostyard/snosi">snosi</a> bootc images —
      container suites, VM boot, and both install paths. Every lane below runs against a
      freshly published image; nothing here is asserted by hand.
    </p>
  </section>

  {empty && (
    <p class="empty">
      No run data yet. The collector CronWorkflow publishes
      <span class="mono">site/src/data/runs.json</span> once a GitHub token secret exists in the
      cluster — see <a href="https://github.com/frostyard/lab#reporting">the README</a>.
    </p>
  )}

  {!empty && (
    <>
      <div class="stats">
        <div class="stat">
          <span>Lanes</span>
          <strong>{lanes.length}</strong>
          <small>tracked pipelines</small>
        </div>
        <div class="stat">
          <span>Passing</span>
          <strong class="ok">{passing}</strong>
          <small>latest run succeeded</small>
        </div>
        <div class="stat">
          <span>Failing</span>
          <strong class={failing > 0 ? 'danger' : ''}>{failing}</strong>
          <small>{moving > 0 ? `${moving} still moving` : 'latest run failed'}</small>
        </div>
        <div class="stat">
          <span>Unproven</span>
          <strong>{unproven}</strong>
          <small>never passed once</small>
        </div>
        <div class="stat">
          <span>Runs</span>
          <strong>{retained}</strong>
          <small>retained in cluster</small>
        </div>
      </div>

      {grouped.map((group, i) => (
        <section class="group">
          <div class="group-head">
            <span class="idx">{String(i + 1).padStart(2, '0')}</span>
            <h3>{group.label}</h3>
            <span class="rule"></span>
            <span class="count">{group.lanes.length} lane{group.lanes.length === 1 ? '' : 's'}</span>
          </div>
          <div class="cards">
            {group.lanes.map((lane) => (
              <article class={`card ${laneState(lane)}`}>
                <div class="card-head">
                  <strong class="name">{lane.label}</strong>
                  <span class={`badge ${laneState(lane)}`}>{laneLabel(lane)}</span>
                </div>
                {laneState(lane) === 'unproven' && (
                  <p class="unproven-note">This lane has never passed. Treat its red as a question about the lane, not a finding about the image.</p>
                )}
                {lane.latest.result && <p class="result">{lane.latest.result}</p>}
                {lane.latest.checks?.length > 0 && (
                  <ul class="checks">
                    {lane.latest.checks.map((c) => {
                      const [k, v] = c.split('=');
                      return <li><span class="k">{k}</span><span class={`v ${v === 'ok' ? 'good' : ''}`}>{v}</span></li>;
                    })}
                  </ul>
                )}
                <p class="meta">
                  {when(lane.latest.finished || lane.latest.started)} · {duration(lane.latest.durationSeconds)} · {lane.runs} run{lane.runs === 1 ? '' : 's'} retained
                </p>
              </article>
            ))}
          </div>
        </section>
      ))}

      <section class="card table-card">
        <div class="table-toolbar">
          <h3>Recent runs</h3>
          <span>{recent.length} of {runs.length} retained</span>
        </div>
        {/* Wide content scrolls inside its own container so the page body never does. */}
        <div class="tablewrap">
          <table>
            <thead>
              <tr><th>Run</th><th>Lane</th><th>Phase</th><th>Started</th><th>Duration</th><th>Result</th></tr>
            </thead>
            <tbody>
              {recent.map((run) => (
                <tr>
                  <td class="mono nowrap">{run.name}</td>
                  <td>{run.label}</td>
                  <td><span class={`badge ${state(run.phase)}`}>{run.phase}</span></td>
                  <td class="nowrap mono dim">{when(run.started)}</td>
                  <td class="nowrap mono dim">{duration(run.durationSeconds)}</td>
                  <td class="result-cell">{run.result || '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </>
  )}
</Layout>

<style>
  /* Hero — the signature two-beat headline over the signal gradient. */
  .hero {
    background: var(--gradient-signal);
    border: 1px solid var(--line-strong);
    margin-bottom: 1.25rem;
    padding: 1.4rem 1.5rem 1.5rem;
  }
  .hero-kicker {
    align-items: center;
    color: #93dff7;
    display: flex;
    font: 700 10px var(--font-mono);
    gap: 7px;
    letter-spacing: .12em;
    margin-bottom: 9px;
    text-transform: uppercase;
  }
  .hero-kicker span:empty { background: var(--sky); border-radius: 50%; height: 7px; width: 7px; }
  .hero h2 {
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -.045em;
    line-height: 1.1;
    margin: 0 0 .55rem;
  }
  .hero h2 em { color: var(--ice); font-family: var(--font-serif-accent); font-weight: 400; }
  .hero p {
    color: var(--text-dim);
    font-size: var(--text-body-size);
    line-height: 1.65;
    margin: 0;
    max-width: 62ch;
  }

  .empty {
    background: var(--gradient-card);
    border: 1px solid var(--line);
    color: var(--text-muted);
    font-size: var(--text-body-size);
    padding: 1.25rem;
  }

  /* Stat tiles */
  .stats {
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-bottom: 2rem;
  }
  .stat {
    background: var(--gradient-card);
    border: 1px solid var(--line);
    display: grid;
    gap: 3px;
    padding: 11px 14px;
  }
  .stat > span {
    color: var(--text-eyebrow);
    font: 750 9px var(--font-mono);
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .stat strong { font-size: 23px; font-weight: 700; letter-spacing: -.05em; }
  .stat strong.ok { color: var(--state-ok); }
  .stat strong.danger { color: var(--state-danger); }
  .stat small { color: var(--text-footer); font-size: 9.5px; }

  /* Group heading — mono index marker, then a hairline out to the count. */
  .group { margin-bottom: 1.75rem; }
  .group-head { align-items: center; display: flex; gap: 10px; margin-bottom: .7rem; }
  .idx { color: var(--sky); font: 400 10px var(--font-mono); letter-spacing: .08em; }
  .group-head h3 {
    font-size: .78rem;
    font-weight: 700;
    letter-spacing: .14em;
    margin: 0;
    text-transform: uppercase;
  }
  .rule { background: var(--line); flex: 1; height: 1px; }
  .count { color: var(--text-footer); font: 400 10px var(--font-mono); letter-spacing: .08em; }

  /* Lane cards — gradient fill, hairline edge, square corners, state on the left rule. */
  .cards { display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr)); }
  .card {
    background: var(--gradient-card);
    border: 1px solid var(--line);
    min-width: 0;
    padding: 13px 15px;
  }
  .card.ok { border-left-color: var(--state-ok); }
  .card.warn { border-left-color: var(--state-warn); }
  .card.danger {
    background: linear-gradient(90deg, rgba(224, 122, 114, .07), transparent 55%), var(--gradient-card);
    border-left-color: var(--state-danger);
  }
  .card-head { align-items: center; display: flex; gap: 10px; justify-content: space-between; }
  .name { font-size: 13px; font-weight: 700; letter-spacing: -.01em; }

  .badge {
    border: 1px solid var(--line-tag);
    border-radius: var(--radius-tag);
    color: var(--tag-text);
    display: inline-flex;
    font: 700 9px var(--font-mono);
    letter-spacing: .08em;
    padding: 4px 7px;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .badge.ok { border-color: #47b8ef4d; color: var(--state-ok); }
  .badge.warn { border-color: #e0b15c55; color: var(--state-warn); }
  .badge.danger { border-color: #e07a7255; color: var(--state-danger); }
  /* Deliberately muted, not alarming: unproven is an absence of evidence,
     not a failure, and colouring it like one recreates the problem it exists
     to solve. */
  .badge.unproven { border-color: var(--line-strong); color: var(--text-dim); }
  .card.unproven { border-left-color: var(--line-strong); }
  .unproven-note { margin: .55rem 0 0; font-size: .8rem; color: var(--text-dim); line-height: 1.5; }

  .result { font-size: 11.5px; line-height: 1.6; margin: .6rem 0 0; }
  .checks { display: flex; flex-wrap: wrap; gap: 5px; list-style: none; margin: .6rem 0 0; padding: 0; }
  .checks li {
    border: 1px solid var(--line);
    border-radius: var(--radius-tag);
    display: flex;
    font: 400 9.5px var(--font-mono);
    gap: 5px;
    padding: 3px 6px;
  }
  .checks .k { color: var(--text-eyebrow); }
  .checks .v { color: var(--text-muted); }
  .checks .v.good { color: var(--state-ok); }
  .meta { color: var(--text-footer); font: 400 9.5px var(--font-mono); margin: .7rem 0 0; }

  /* Recent runs table */
  .table-card { overflow: hidden; padding: 0; }
  .table-toolbar {
    align-items: center;
    border-bottom: 1px solid var(--line);
    display: flex;
    gap: 10px;
    justify-content: space-between;
    padding: 10px 14px;
  }
  .table-toolbar h3 { font-size: 13px; font-weight: 700; letter-spacing: -.01em; margin: 0; }
  .table-toolbar span { color: var(--text-footer); font: 400 10px var(--font-mono); }
  .tablewrap { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; }
  th {
    color: var(--text-eyebrow);
    font: 750 9px var(--font-mono);
    letter-spacing: .12em;
    padding: 8px 14px;
    text-align: left;
    text-transform: uppercase;
    white-space: nowrap;
  }
  td { border-top: 1px solid var(--line); font-size: 11.5px; padding: 8px 14px; vertical-align: middle; }
  .mono { font-family: var(--font-mono); font-size: 10px; }
  td.mono { color: var(--text-mono-accent); }
  td.dim { color: var(--text-footer); }
  .nowrap { white-space: nowrap; }
  .result-cell { color: var(--text-muted); max-width: 24rem; }

  @media (max-width: 900px) {
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .stats { grid-template-columns: 1fr; }
    .hero { padding: 1.2rem 1.15rem 1.3rem; }
  }
</style>
